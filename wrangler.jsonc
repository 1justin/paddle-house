{
	"compatibility_date": "2026-04-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "paddle-house",
	// Keep INQUIRY_* vars set in the Cloudflare dashboard; without this, each deploy wipes them.
	"keep_vars": true,
	"vars": {
		// Who gets emailed if the inquiry form can't deliver a guest's note.
		"ALERT_TO": "justin@wrkstream.com,hellogoosehill@gmail.com"
	},
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}