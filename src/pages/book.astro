---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Write to John & Erin | The Paddle House at Goose Hill"
  description="Tell us about your group and your dates. We'll write back the same day."
  current="book"
>
  {/* ─────────────────────────── HERO ─────────────────────────── */}
  <section class="relative h-[55vh] md:h-[62vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 reveal-mask">
      <img
        src="/paddle-house-pics/pool.webp"
        alt="The Paddle House"
        class="w-full h-full object-cover"
        data-parallax="10"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-parchment/90 via-parchment/50 to-transparent"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-10 w-full pt-24">
      <div class="max-w-2xl">
        <p class="font-label text-xs tracking-[0.3em] uppercase text-copper mb-5 reveal">
          Weekends &amp; Gatherings
        </p>
        <h1 class="reveal-chars font-display text-5xl md:text-7xl text-ink leading-[1.05] tracking-tight letterpress">
          Write to John &amp; Erin.
        </h1>
        <p class="reveal mt-6 font-body text-ink/70 text-lg md:text-xl max-w-lg leading-relaxed">
          Tell us about your group and your dates. We'll write back the same day.
        </p>
      </div>
    </div>
  </section>

  {/* ─────────────────────── FORM + SIDEBAR ─────────────────────── */}
  <section id="inquiry-form" class="bg-parchment py-20 md:py-28 paper">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      {/* Form */}
      <div class="lg:col-span-7 bg-parchment-warm p-8 md:p-12 editorial-shadow reveal">
        <div class="mb-10">
          <p class="font-label text-xs tracking-[0.25em] uppercase text-moss mb-3">An Inquiry</p>
          <h2 class="font-display text-3xl md:text-4xl text-ink leading-tight mb-3">Tell us about your weekend.</h2>
          <p class="font-body text-ink/60">No form fields we don't actually need. We usually reply within the day.</p>
        </div>
        <form
          class="space-y-8"
          onsubmit="event.preventDefault(); document.getElementById('formSuccess').classList.remove('hidden'); this.classList.add('hidden');"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="name">Your name</label>
              <input id="name" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="Jane Smith" type="text" required />
            </div>
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="email">Email</label>
              <input id="email" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="jane@example.com" type="email" required />
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="dates">Dates you're eyeing</label>
              <div class="relative">
                <input id="dates" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 pl-12 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="A weekend in February" type="text" />
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-copper text-xl">calendar_today</span>
              </div>
            </div>
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="group-type">What kind of group</label>
              <select id="group-type" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all appearance-none">
                <option>Paddle weekend</option>
                <option>Family gathering</option>
                <option>Off-site or retreat</option>
                <option>Tournament or round robin</option>
                <option>Birthday or milestone</option>
                <option>Something else</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="guests">How many</label>
              <input id="guests" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="8" type="number" min="1" max="16" />
            </div>
            <div class="space-y-2">
              <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="players">Of those, how many play paddle</label>
              <input id="players" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="6" type="number" min="0" />
            </div>
          </div>
          <div class="space-y-2">
            <label class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-ink/70" for="notes">Anything else</label>
            <textarea id="notes" class="w-full bg-parchment border border-ink/10 rounded-sm p-4 font-body text-ink focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none transition-all" placeholder="Dietary notes, a tournament idea, a birthday to mark, a dog coming along..." rows="4"></textarea>
          </div>
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <button type="submit" class="flex-1 bg-moss-dark text-parchment-warm py-5 rounded-full font-label text-sm font-semibold tracking-wide hover:bg-ink transition-colors">
              Send the note
            </button>
            <a
              href="mailto:hello@thepaddlehouse.com"
              class="px-8 py-5 rounded-full font-label text-sm font-semibold tracking-wide text-ink border border-ink/20 hover:bg-ink/5 transition-colors text-center"
            >
              Or email directly
            </a>
          </div>
        </form>
        {/* Success state */}
        <div id="formSuccess" class="hidden text-center py-16">
          <span class="material-symbols-outlined text-moss text-6xl mb-6" style="font-variation-settings:'FILL' 1">check_circle</span>
          <h3 class="font-display text-3xl text-ink mb-4">The note's on its way.</h3>
          <p class="font-body text-ink/65 text-lg max-w-md mx-auto">John or Erin will write back the same day. Usually sooner.</p>
        </div>
      </div>

      {/* Sidebar */}
      <div class="lg:col-span-5 space-y-12">
        {/* Availability calendar */}
        <div class="bg-parchment-deep p-8 editorial-shadow reveal">
          <div class="flex justify-between items-end mb-6">
            <h3 class="font-display text-2xl text-ink">Availability</h3>
            <span class="font-label text-xs font-semibold tracking-[0.2em] uppercase text-moss">Summer 2026</span>
          </div>
          <div class="grid grid-cols-7 gap-1.5 text-center">
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">S</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">M</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">T</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">W</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">T</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">F</div>
            <div class="font-label text-[10px] tracking-widest uppercase text-ink/50 py-2">S</div>

            <div class="p-2.5 text-xs text-ink/30">28</div>
            <div class="p-2.5 text-xs text-ink/30">29</div>
            <div class="p-2.5 text-xs text-ink/30">30</div>
            <div class="p-2.5 text-xs font-medium text-ink">1</div>
            <div class="p-2.5 text-xs font-medium text-ink">2</div>
            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">3</div>
            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">4</div>

            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">5</div>
            <div class="p-2.5 text-xs font-medium text-ink">6</div>
            <div class="p-2.5 text-xs font-medium text-ink">7</div>
            <div class="p-2.5 text-xs font-medium text-ink">8</div>
            <div class="p-2.5 text-xs font-medium text-ink">9</div>
            <div class="p-2.5 text-xs font-medium text-ink">10</div>
            <div class="p-2.5 text-xs font-medium text-ink">11</div>

            <div class="p-2.5 text-xs font-semibold bg-moss/20 text-moss-dark rounded-sm">12</div>
            <div class="p-2.5 text-xs font-semibold bg-moss/20 text-moss-dark rounded-sm">13</div>
            <div class="p-2.5 text-xs font-medium text-ink">14</div>
            <div class="p-2.5 text-xs font-medium text-ink">15</div>
            <div class="p-2.5 text-xs font-medium text-ink">16</div>
            <div class="p-2.5 text-xs font-medium text-ink">17</div>
            <div class="p-2.5 text-xs font-medium text-ink">18</div>

            <div class="p-2.5 text-xs font-medium text-ink">19</div>
            <div class="p-2.5 text-xs font-medium text-ink">20</div>
            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">21</div>
            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">22</div>
            <div class="p-2.5 text-xs font-medium bg-barn/15 text-barn line-through rounded-sm">23</div>
            <div class="p-2.5 text-xs font-medium text-ink">24</div>
            <div class="p-2.5 text-xs font-medium text-ink">25</div>
          </div>
          <div class="mt-6 flex items-center gap-5 font-label text-[10px] tracking-[0.2em] uppercase text-ink/55">
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-barn"></span> Booked</span>
            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-moss"></span> Hold</span>
          </div>
        </div>

        {/* What's included */}
        <div class="space-y-6 reveal">
          <p class="font-label text-xs tracking-[0.3em] uppercase text-copper">What comes with</p>
          <h3 class="font-display text-3xl text-ink italic">The whole place.</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">sports_tennis</span>
              <span class="font-body text-ink/80 text-sm">Heated paddle court</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">pool</span>
              <span class="font-body text-ink/80 text-sm">Heated pool</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">bed</span>
              <span class="font-body text-ink/80 text-sm">Six bedrooms, up to sixteen</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">cabin</span>
              <span class="font-body text-ink/80 text-sm">Restored barn</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">local_fire_department</span>
              <span class="font-body text-ink/80 text-sm">Fire pit and hearths</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">water</span>
              <span class="font-body text-ink/80 text-sm">Pond and private dock</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">restaurant</span>
              <span class="font-body text-ink/80 text-sm">Chef on request</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined text-moss">explore</span>
              <span class="font-body text-ink/80 text-sm">A local itinerary, if you want one</span>
            </li>
          </ul>
        </div>

        <div class="reveal-mask aspect-[4/3] overflow-hidden editorial-shadow">
          <img
            src="/paddle-house-pics/pond.webp"
            alt="The pond at Goose Hill"
            class="w-full h-full object-cover img-zoom"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────── CTA ─────────────────── */}
  <section class="bg-moss-dark text-parchment-warm py-24 md:py-32 paper">
    <div class="max-w-4xl mx-auto px-6 md:px-10 text-center">
      <p class="font-label text-xs tracking-[0.3em] uppercase text-parchment-warm/60 mb-6 reveal">
        Prefer the old-fashioned way
      </p>
      <h2 class="reveal-chars font-display text-3xl md:text-5xl leading-[1.1] tracking-tight">
        You can just email.
      </h2>
      <div class="reveal mt-8">
        <a
          href="mailto:hello@thepaddlehouse.com"
          class="inline-flex items-center gap-2 bg-parchment text-ink px-9 py-4 rounded-full font-label text-sm font-semibold tracking-wide hover:bg-parchment-warm transition-colors"
        >
          hello@thepaddlehouse.com
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
      <p class="reveal mt-8 font-body italic text-parchment-warm/70">John &amp; Erin</p>
    </div>
  </section>
</Layout>
