---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-parchment-warm paper">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-20 md:py-28">
    <div class="grid md:grid-cols-[1.2fr_1fr_1fr] gap-12 md:gap-16">
      <div>
        <p class="font-display text-3xl md:text-4xl leading-tight">
          The Paddle House<br /><span class="text-parchment-warm/60"
            >at Goose Hill</span
          >
        </p>
        <p class="mt-6 font-body text-parchment-warm/70 max-w-sm text-[17px] leading-relaxed">
          An 18th&#8209;century farmhouse in Washington, Connecticut, with a
          paddle court out back and two hosts who will make you feel right at
          home.
        </p>
      </div>

      <div>
        <p class="font-label text-xs tracking-[0.25em] uppercase text-parchment-warm/50 mb-5">
          Visit
        </p>
        <ul class="space-y-2 font-body text-parchment-warm/85">
          <li><a class="hover:text-copper-soft transition-colors" href="/experience">The Experience</a></li>
          <li><a class="hover:text-copper-soft transition-colors" href="/accommodations">Accommodations</a></li>
          <li><a class="hover:text-copper-soft transition-colors" href="/our-story">Our Story</a></li>
          <li><a class="hover:text-copper-soft transition-colors" href="/book">Book a Stay</a></li>
        </ul>
      </div>

      <div>
        <p class="font-label text-xs tracking-[0.25em] uppercase text-parchment-warm/50 mb-5">
          Write to us
        </p>
        <a
          href="mailto:hello@thepaddlehouse.com"
          class="font-body text-parchment-warm hover:text-copper-soft transition-colors"
          >hello@thepaddlehouse.com</a
        >
        <p class="mt-6 font-body italic text-parchment-warm/70 leading-relaxed">
          John &amp; Erin
        </p>
      </div>
    </div>

    <div class="rule my-14 opacity-40"></div>

    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 font-label text-xs tracking-wide text-parchment-warm/45"
    >
      <p>© {year} The Paddle House at Goose Hill. Washington, CT.</p>
      <p>Built with care on old floorboards.</p>
    </div>
  </div>
</footer>
