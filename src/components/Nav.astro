---
interface Props {
  current?: "experience" | "accommodations" | "story" | "book" | "home";
}
const { current = "home" } = Astro.props;

const links = [
  { href: "/experience", label: "Experience", key: "experience" },
  { href: "/accommodations", label: "Accommodations", key: "accommodations" },
  { href: "/our-story", label: "Our Story", key: "story" },
  { href: "/book", label: "Book", key: "book" },
];
---

<nav
  id="mainNav"
  class="fixed top-0 w-full z-50 bg-parchment/80 backdrop-blur-xl border-b border-patina/10 transition-all duration-500"
>
  <div
    class="max-w-7xl mx-auto px-6 md:px-10 py-5 flex justify-between items-center"
  >
    <a
      href="/"
      class="flex items-center gap-3 font-display text-xl md:text-2xl font-bold tracking-tight text-ink hover:text-moss transition-colors"
      aria-current={current === "home" ? "page" : undefined}
    >
      <img
        src="/assets/logo-160.png"
        alt=""
        width="44"
        height="44"
        class="w-10 h-10 md:w-11 md:h-11 rounded-full"
      />
      The Paddle&nbsp;House
    </a>

    <div class="hidden md:flex gap-9 items-center">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.key ? "page" : undefined}
            class:list={[
              "font-label text-sm tracking-wide transition-colors relative",
              current === l.key
                ? "text-ink"
                : "text-ink/55 hover:text-moss",
            ]}
          >
            {l.label}
            {current === l.key && (
              <span class="absolute -bottom-1 left-0 right-0 h-px bg-copper" />
            )}
          </a>
        ))
      }
    </div>

    <a
      href="/book"
      class="hidden md:inline-block bg-moss text-parchment-warm px-7 py-2.5 rounded-full font-label text-sm font-semibold tracking-wide hover:bg-moss-dark transition-all shadow-sm"
    >
      Write to John &amp; Erin
    </a>

    <button
      id="mobileToggle"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="block w-6 h-0.5 bg-ink transition-all"></span>
      <span class="block w-6 h-0.5 bg-ink transition-all"></span>
      <span class="block w-4 h-0.5 bg-ink transition-all"></span>
    </button>
  </div>
</nav>

<div
  id="mobileMenu"
  class="fixed inset-0 z-40 bg-parchment translate-x-full transition-transform duration-[450ms] ease-[cubic-bezier(0.2,0.6,0.2,1)] md:hidden"
  aria-hidden="true"
>
  <div class="flex flex-col h-full px-8 pt-28 pb-10 gap-6">
    {
      links.map((l) => (
        <a
          href={l.href}
          class="font-display text-4xl text-ink hover:text-moss transition-colors"
        >
          {l.label}
        </a>
      ))
    }
    <div class="mt-auto">
      <a
        href="/book"
        class="inline-block bg-moss text-parchment-warm px-8 py-3 rounded-full font-label text-sm font-semibold tracking-wide"
      >
        Write to John &amp; Erin
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("mobileToggle");
  const menu = document.getElementById("mobileMenu");
  const setMenu = (isOpen: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle("translate-x-full", !isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    menu.setAttribute("aria-hidden", String(!isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("translate-x-full");
    setMenu(Boolean(isOpen));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.classList.contains("translate-x-full")) {
      setMenu(false);
    }
  });

  const nav = document.getElementById("mainNav");
  let last = 0;
  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    if (!nav) return;
    if (y > 80) nav.classList.add("py-3", "shadow-sm");
    else nav.classList.remove("py-3", "shadow-sm");
    last = y;
  });
</script>
